# Debian preseed configuration template
# Generated by scripts/generate-preseed.sh
# Target: Supermicro SYS-6019U-TN4R4T / NVMe / UEFI

### Localization
d-i debian-installer/locale string en_US.UTF-8
d-i debian-installer/language string en
d-i debian-installer/country string JP
d-i keyboard-configuration/xkb-keymap select us

### Console
d-i debian-installer/add-kernel-opts string %%CONSOLE_ORDER%%

### Early command - Forwards installer syslog to 10.1.6.1:5514 for diagnostics.
### (VLAN setup at this stage cannot work: stock d-i initrd lacks the 8021q
### kernel module, so VLAN trunk hosts use post-install bridge configuration
### instead — see late_command and pve-bridge-setup.sh.)
d-i preseed/early_command string \
  kill $(cat /var/run/syslogd.pid 2>/dev/null) 2>/dev/null || true; \
  syslogd -R 10.1.6.1:5514 -L -O /var/log/syslog -S 2>/dev/null || true; \
  sleep 2; \
  echo "pvese: preseed/early_command start (%%HOSTNAME%%)" > /dev/kmsg 2>/dev/null || true; \
  :

### Network
### VLAN trunk hosts (set NETCFG_DISABLE_AUTOCONFIG=true) skip d-i DHCP and
### feed netcfg the static IP directly. The actual network configuration
### lives in /target/etc/network/interfaces written by late_command — these
### static answers exist solely to keep the netcfg dialog from blocking on
### prompts when the trunk has no untagged carrier during install.
d-i netcfg/disable_autoconfig boolean %%NETCFG_DISABLE_AUTOCONFIG%%
d-i netcfg/dhcp_failed note
d-i netcfg/dhcp_options select Configure network manually
d-i netcfg/choose_interface select %%CHOOSE_INTERFACE%%
d-i netcfg/get_ipaddress string %%STATIC_IP%%
d-i netcfg/get_netmask string %%STATIC_NETMASK_OCTET%%
d-i netcfg/get_gateway string %%STATIC_GATEWAY%%
d-i netcfg/get_nameservers string 8.8.8.8 1.1.1.1
d-i netcfg/confirm_static boolean true
d-i netcfg/get_hostname string %%HOSTNAME%%
d-i netcfg/get_domain string %%DOMAIN%%
### Suppress "Continue without a default route?" and "Gateway unreachable" dialogs.
### The management network (10.0.0.0/8) has no internet path, so default route
### checking always fails. These directives auto-accept and continue.
d-i netcfg/no_default_route boolean true
d-i netcfg/gateway_unreachable boolean true

### Mirror
### When the host has no usable network during install (VLAN trunk on stock
### initrd) we install CD-only, exactly like server7-9; pre-pve-setup.sh
### populates apt sources after first boot once the bridge is up.
d-i mirror/country string manual
d-i mirror/http/hostname string deb.debian.org
d-i mirror/http/directory string /debian
d-i mirror/http/proxy string
d-i apt-setup/use_mirror boolean %%APT_USE_MIRROR%%
d-i apt-setup/no_mirror boolean %%APT_NO_MIRROR%%
d-i apt-setup/cdrom/set-first boolean true
d-i apt-setup/cdrom/set-next boolean %%APT_USE_MIRROR%%
d-i apt-setup/cdrom/set-double boolean false
d-i apt-setup/cdrom/set-failed boolean false

### Kernel modules: skip loading extra udebs from archive
### (prevents "No kernel modules found" error when ISO kernel != archive kernel)
d-i anna/no_kernel_modules boolean true

### Clock and time zone
d-i clock-setup/utc boolean true
d-i time/zone string Asia/Tokyo
d-i clock-setup/ntp boolean true

### Partitioning - use entire disk with LVM
### IMPORTANT: Always boot the installer in UEFI mode for NVMe targets.
### When booted in UEFI mode, partman auto-creates GPT + ESP.
### When booted in Legacy mode, partman creates MBR — NVMe cannot Legacy-boot,
### and preseed directives like disk_label/default_label/early_command cannot
### force GPT creation under Legacy ISOLINUX (tested and confirmed non-functional).
d-i partman-auto/disk string %%DISK%%
d-i partman-auto/method string lvm
d-i partman-auto-lvm/guided_size string max
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-lvm/confirm boolean true
d-i partman-lvm/confirm_nooverwrite boolean true
### partman-efi/non_efi_system: allows partman to proceed on non-EFI systems
### (needed for Legacy/DUAL boot mode; harmless in UEFI mode)
d-i partman-efi/non_efi_system boolean true
d-i partman-auto/choose_recipe select atomic
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true

### Root password
d-i passwd/root-login boolean true
d-i passwd/root-password password %%ROOT_PASSWORD%%
d-i passwd/root-password-again password %%ROOT_PASSWORD%%

### User account
d-i passwd/user-fullname string Debian User
d-i passwd/username string %%USER_NAME%%
d-i passwd/user-password password %%USER_PASSWORD%%
d-i passwd/user-password-again password %%USER_PASSWORD%%
d-i user-setup/allow-password-weak boolean true
d-i passwd/user-default-groups string audio cdrom dip floppy video plugdev netdev sudo

### APT / Package selection
### VLAN trunk hosts install CD-only, so tasksel must not request the
### "standard" task (curl/wget/etc are not on the netinst CD) — pre-pve-setup.sh
### apt-installs the missing packages once the bridge is up.
tasksel tasksel/first multiselect %%TASKSEL_FIRST%%
d-i pkgsel/include string %%PKGSEL_INCLUDE%%
d-i pkgsel/upgrade select %%PKGSEL_UPGRADE%%
d-i pkgsel/update-policy select none
popularity-contest popularity-contest/participate boolean false

### Boot loader
d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean true
d-i grub-installer/bootdev string %%DISK%%
d-i grub-installer/force-efi-extra-removable boolean true

### Finish - halt instead of reboot to prevent re-booting from CD
d-i finish-install/reboot_in_progress note
d-i debian-installer/exit/poweroff boolean true

### Late command - add startup.nsh as EFI Shell fallback, configure SSH access
### Requires UEFI mode installation (grub-efi-amd64 auto-installed by d-i).
### startup.nsh provides a fallback path if UEFI boot order is misconfigured.
### SSH configuration: sets PermitRootLogin yes, installs project public key,
### sets up sudoers NOPASSWD for the debian user.
### The "strip gateway" sed below removes the `gateway %%STATIC_GATEWAY%%` line
### that d-i netcfg writes into /etc/network/interfaces from the static-IP
### dialog answers (netcfg/get_gateway). The 10.0.0.0/8 management network has
### no internet path, so leaving that line lets ifupdown re-evaluation install
### default via 10.10.10.1 on every reboot — breaking apt during the
### pve-setup-remote.sh post-reboot phase. The sed is a no-op on VLAN hosts
### because %%LATE_NETWORK%% overwrites the file right after.
### The late_network block (substituted below) expands to either:
###   - non-VLAN hosts: a single auto/iface block APPENDED to the netcfg-written
###     interfaces file (preserves the existing static IP block).
###   - VLAN hosts: the entire interfaces file OVERWRITTEN (lo + <phy> manual +
###     <phy>.<internet_vlan> dhcp + <phy>.<internal_vlan> static) plus 8021q
###     persistence in /etc/modules. The overwrite is required because d-i
###     netcfg writes `iface <phy> inet static` to the file, and an append-only
###     late_command would leave the static IP on both the untagged NIC and the
###     VLAN sub, breaking SSH on first boot.
d-i preseed/late_command string \
    echo "fs0:\\efi\\debian\\shimx64.efi" > /target/boot/efi/startup.nsh; \
    in-target sed -i "s/^#*PermitRootLogin.*/PermitRootLogin yes/" /etc/ssh/sshd_config; \
    in-target mkdir -p /root/.ssh; \
    in-target chmod 700 /root/.ssh; \
    echo "%%SSH_PUBLIC_KEY%%" > /target/root/.ssh/authorized_keys; \
    in-target chmod 600 /root/.ssh/authorized_keys; \
    echo "%%USER_NAME%% ALL=(ALL) NOPASSWD: ALL" > /target/etc/sudoers.d/%%USER_NAME%%; \
    in-target chmod 0440 /etc/sudoers.d/%%USER_NAME%%; \
    in-target sed -i "/^[[:space:]]*gateway[[:space:]]\\+%%STATIC_GATEWAY%%[[:space:]]*\$/d" /etc/network/interfaces; \
    %%LATE_NETWORK%% \
    true

# Note: Server 7 (R320/iDRAC7) uses preseed/preseed-server7.cfg (手動管理)
# - ミラーなし (apt-setup/use_mirror false, no_mirror true)
# - apt-setup/cdrom/set-double boolean false が必須
# - preseed/file=/cdrom/preseed.cfg (initrd 注入禁止)
