[global]
workgroup = WORKGROUP
server string = TX1320 Virtual Media SMB
netbios name = SMB6
log file = /var/log/samba/log.%m
log level = 10
max log size = 0
map to guest = Bad User
guest account = nobody
server min protocol = NT1
client min protocol = NT1
server max protocol = SMB3
smb1 unix extensions = yes
smb ports = 445 139

[public]
path = /var/samba/public
browseable = yes
read only = yes
guest ok = yes
force user = nobody
